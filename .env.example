# Postgres connection string (Neon, or any Postgres 16 instance)
DATABASE_URL=postgresql://user:password@host:5432/taskkit?sslmode=require

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# svix signing secret for /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_xxx

# Optional: local preview without Clerk. Ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
